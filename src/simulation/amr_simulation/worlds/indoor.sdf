<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="indoor_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="ignition-gazebo-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="ignition-gazebo-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="ignition-gazebo-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="ignition-gazebo-contact-system"/>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 15 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.9</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Ground Plane (20x20m room area on 100x100m plane) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Room Structure: 20x20m with 5 distinct compartments separated by walls with unique bends -->
    <model name="building_structure">
      <static>true</static>

      <!-- Outer Boundary Walls (20x20m) -->
      <link name="wall_outer_north">
        <pose>0 10 1.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>20.4 0.2 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>20.4 0.2 2.5</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="wall_outer_south">
        <pose>0 -10 1.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>20.4 0.2 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>20.4 0.2 2.5</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="wall_outer_west">
        <pose>-10 0 1.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.2 20.0 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 20.0 2.5</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="wall_outer_east">
        <pose>10 0 1.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.2 20.0 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 20.0 2.5</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Partition 1: SW Compartment (L-Shape Bend Wall - 90 Degree Turn) -->
      <link name="wall_sw_l1">
        <pose>-7.0 -2.0 1.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>6.0 0.2 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>6.0 0.2 2.5</size></box></geometry>
          <material><ambient>0.7 0.65 0.6 1</ambient><diffuse>0.7 0.65 0.6 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_sw_l2">
        <pose>-4.0 -0.5 1.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.2 3.0 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 3.0 2.5</size></box></geometry>
          <material><ambient>0.7 0.65 0.6 1</ambient><diffuse>0.7 0.65 0.6 1</diffuse></material>
        </visual>
      </link>

      <!-- Partition 2: NW Compartment (Z-Shape / Step-Bend Wall) -->
      <link name="wall_nw_z1">
        <pose>-8.0 2.0 1.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>4.0 0.2 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>4.0 0.2 2.5</size></box></geometry>
          <material><ambient>0.6 0.7 0.65 1</ambient><diffuse>0.6 0.7 0.65 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_nw_z2">
        <pose>-6.0 3.5 1.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.2 3.0 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 3.0 2.5</size></box></geometry>
          <material><ambient>0.6 0.7 0.65 1</ambient><diffuse>0.6 0.7 0.65 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_nw_z3">
        <pose>-4.0 5.0 1.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>4.0 0.2 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>4.0 0.2 2.5</size></box></geometry>
          <material><ambient>0.6 0.7 0.65 1</ambient><diffuse>0.6 0.7 0.65 1</diffuse></material>
        </visual>
      </link>

      <!-- Partition 3: Divider between NW & NE (T-Junction Bend Wall) -->
      <link name="wall_ne_t1">
        <pose>0.0 7.0 1.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.2 6.0 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 6.0 2.5</size></box></geometry>
          <material><ambient>0.65 0.6 0.7 1</ambient><diffuse>0.65 0.6 0.7 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_ne_t2">
        <pose>1.25 6.0 1.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>2.5 0.2 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>2.5 0.2 2.5</size></box></geometry>
          <material><ambient>0.65 0.6 0.7 1</ambient><diffuse>0.65 0.6 0.7 1</diffuse></material>
        </visual>
      </link>

      <!-- Partition 4: NE Compartment Inner Partition (U-Hook Bend Wall) -->
      <link name="wall_ne_u1">
        <pose>5.5 2.0 1.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>5.0 0.2 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>5.0 0.2 2.5</size></box></geometry>
          <material><ambient>0.65 0.65 0.7 1</ambient><diffuse>0.65 0.65 0.7 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_ne_u2">
        <pose>8.0 3.5 1.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.2 3.0 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 3.0 2.5</size></box></geometry>
          <material><ambient>0.65 0.65 0.7 1</ambient><diffuse>0.65 0.65 0.7 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_ne_u3">
        <pose>6.5 5.0 1.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>3.0 0.2 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.0 0.2 2.5</size></box></geometry>
          <material><ambient>0.65 0.65 0.7 1</ambient><diffuse>0.65 0.65 0.7 1</diffuse></material>
        </visual>
      </link>

      <!-- Partition 5: SE Compartment (45-degree Diagonal / Angled Wall Bend) -->
      <link name="wall_se_a1">
        <pose>7.0 -1.5 1.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>6.0 0.2 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>6.0 0.2 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.6 1</ambient><diffuse>0.7 0.7 0.6 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_se_a2">
        <pose>2.75 -2.75 1.25 0 0 -0.785398</pose>
        <collision name="col"><geometry><box><size>3.535 0.2 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.535 0.2 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.6 1</ambient><diffuse>0.7 0.7 0.6 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_se_a3">
        <pose>1.5 -5.25 1.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.2 2.5 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 2.5 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.6 1</ambient><diffuse>0.7 0.7 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 5 Small Items / Props placed across the compartments -->

    <!-- Item 1: Small Wooden Crate (Central Atrium) -->
    <model name="prop_crate_center">
      <static>true</static>
      <pose>-1.5 -0.5 0.25 0 0 0.2</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material>
            <ambient>0.55 0.35 0.15 1</ambient>
            <diffuse>0.55 0.35 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Item 2: Small Metal Barrel (SW Compartment) -->
    <model name="prop_barrel_sw">
      <static>true</static>
      <pose>-7.0 -6.0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.25</radius><length>0.7</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.25</radius><length>0.7</length></cylinder></geometry>
          <material>
            <ambient>0.2 0.4 0.65 1</ambient>
            <diffuse>0.2 0.4 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Item 3: Workshop Workbench Table (NW Compartment) -->
    <model name="prop_table_nw">
      <static>true</static>
      <pose>-6.0 7.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.7 0.7 0.5</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.7 0.7 0.5</size></box></geometry>
          <material>
            <ambient>0.25 0.25 0.3 1</ambient>
            <diffuse>0.25 0.25 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Item 4: Small Spherical Container (NE Compartment) -->
    <model name="prop_sphere_ne">
      <static>true</static>
      <pose>7.0 7.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
        </collision>
        <visual name="vis">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
          <material>
            <ambient>0.85 0.4 0.1 1</ambient>
            <diffuse>0.85 0.4 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Item 5: Small Equipment Box (SE Compartment) -->
    <model name="prop_box_se">
      <static>true</static>
      <pose>6.0 -6.0 0.2 0 0 0.4</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.6 0.4 0.4</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.6 0.4 0.4</size></box></geometry>
          <material>
            <ambient>0.3 0.5 0.2 1</ambient>
            <diffuse>0.3 0.5 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
